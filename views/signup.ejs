<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>

    <link rel="stylesheet" href="/css/styles.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body>

    <div class="container">
        <div class="brand">
            <i class="fas fa-tshirt brand-icon"></i>
            <h1>Vybe</h1>
            <p>Your Premium Fashion Destination</p>
        </div>

        <div class="auth-card">

            <div class="tab-switcher">
                <a href="/login" class="tab-btn"
                    style="text-decoration: none; text-align: center; display: inline-block; width: 50%;">Login</a>

                <a href="/signup" class="tab-btn active"
                    style="text-decoration: none; text-align: center; display: inline-block; width: 50%;">Sign Up</a>

                <div class="tab-indicator right"></div>
            </div>

            <% if (locals.error) { %>
                <div style="color: red; text-align:center; margin-bottom:10px;">
                    <%= error %>
                </div>
                <% } %>

                    <form action="/signup" method="POST" enctype="multipart/form-data" class="auth-form active">

                        <h2>Create Account</h2>
                        <p class="form-subtitle">Join Vybe today</p>

                        <div class="input-group">
                            <i class="fas fa-user"></i>
                            <input type="text" name="name" placeholder="Full Name" required>
                        </div>

                        <div class="input-group">
                            <i class="fas fa-envelope"></i>
                            <input type="email" name="email" placeholder="Email" required>
                        </div>

                        <div class="input-group">
                            <i class="fas fa-at"></i>
                            <input type="text" name="username" placeholder="Username" required>
                        </div>

                        <div class="input-group">
                            <i class="fas fa-lock"></i>
                            <input type="password" id="signupPassword" name="password" placeholder="Password" minlength="8"
                                pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z\d]).{8,}"
                                title="Password must be at least 8 characters and include uppercase, lowercase, number, and special character."
                                required>
                            <i class="fas fa-eye toggle-password" data-target="signupPassword"></i>
                        </div>

                        <div class="input-group">
                            <i class="fas fa-lock"></i>
                            <input type="password" id="signupConfirmPassword" name="confirmPassword" placeholder="Confirm Password" required>
                            <i class="fas fa-eye toggle-password" data-target="signupConfirmPassword"></i>
                        </div>

                        <div class="input-group">
                            <label
                                style="display: block; color: var(--text-muted); font-size: 0.9rem; margin-bottom: 8px; font-weight: 500;">
                                <i class="fas fa-image"></i> Upload Profile Picture
                            </label>
                            <input type="file" name="profilePic" accept="image/*" required
                                style="padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; width: 100%; cursor: pointer;">
                        </div>

                        <button type="submit" class="auth-btn">
                            <i class="fas fa-user-plus"></i> Signup
                        </button>

                    </form>

        </div>
    </div>

    <script src="/js/script2.js"></script>
</body>

</html>
