<nav class="navbar">
<div id="auth-state" data-loggedin="<%= user ? 'true' : 'false' %>" style="display:none;"></div>

<div class="nav-container">

    <!-- LOGO -->
    <a href="/" class="nav-logo">
        <img src="/images/logo.jpeg" alt="Vybe Logo" class="logo-img">
    </a>

    <!-- MENU -->
    <ul class="nav-menu">
        <li><a href="/men" class="nav-links">MEN</a></li>
        <li><a href="/women" class="nav-links">WOMEN</a></li>
        <li><a href="/kids" class="nav-links">KIDS</a></li>
        <li><a href="/home-living" class="nav-links">HOME & LIVING</a></li>
        <li><a href="/beauty" class="nav-links">BEAUTY</a></li>
    </ul>

    <!-- ICONS -->
    <div class="nav-icons">

        <!-- Search -->
        <a href="#"><i class="fa-solid fa-magnifying-glass"></i></a>

        <!-- PROFILE -->
        <% if (user) { %>

            <div style="display:flex; align-items:center; gap:10px;">

                <!-- PROFILE PIC -->
                <% if (user.profilePic) { %>
                    <img 
                        src="/uploads/<%= user.profilePic %>" 
                        alt="profile"
                        style="width:36px; height:36px; border-radius:50%; object-fit:cover; border:1px solid #ccc;"
                        onerror="this.onerror=null; this.src='/images/default-user.png';"
                    >
                <% } else { %>
                    <img 
                        src="/images/default-user.png"
                        style="width:36px; height:36px; border-radius:50%; object-fit:cover;"
                    >
                <% } %>

                <!-- USERNAME -->
                <span style="font-weight:500; font-size:14px;">
                    <%= user.username || user.name %>
                </span>

                <!-- LOGOUT -->
                <a href="/logout" 
                   style="margin-left:8px; color:red; font-size:13px; text-decoration:none;">
                   Logout
                </a>

            </div>

        <% } else { %>

            <!-- NOT LOGGED IN -->
            <a href="/login">
                <i class="fa-regular fa-user"></i>
            </a>

        <% } %>

        <!-- Wishlist -->
        <a href="/wishlist"><i class="fa-regular fa-heart"></i></a>

        <!-- Cart -->
        <a href="/cart" class="cart-icon">
            <i class="fa-solid fa-bag-shopping"></i>
            <span id="cart-count" class="cart-count">0</span>
        </a>

    </div>

</div>
</nav>
