<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <link rel="stylesheet" href="/css/styles.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body>

    <div class="container">
        <div class="brand">
            <i class="fas fa-tshirt brand-icon"></i>
            <h1>Vybe</h1>
            <p>Your Premium Fashion Destination</p>
        </div>

        <div class="auth-card">

            <!-- TAB SWITCH -->
            <div class="tab-switcher">
                <a href="/login" class="tab-btn active"
                    style="text-decoration: none; text-align: center; display: inline-block; width: 50%;">Login</a>

                <a href="/signup" class="tab-btn"
                    style="text-decoration: none; text-align: center; display: inline-block; width: 50%;">Sign Up</a>

                <div class="tab-indicator"></div>
            </div>

            <!-- ERROR -->
            <% if (locals.error) { %>
                <div style="color: red; text-align: center; margin-bottom: 10px;">
                    <%= error %>
                </div>
            <% } %>

            <!-- SUCCESS -->
            <% if (locals.success) { %>
                <div style="color: green; text-align: center; margin-bottom: 10px;">
                    <%= success %>
                </div>
            <% } %>

            <!-- LOGIN FORM -->
            <form action="/login" method="POST" class="auth-form active">

                <h2>Welcome Back!</h2>

                <!-- USERNAME -->
                <div class="input-group">
                    <i class="fas fa-user"></i>
                    <input type="text" name="username" placeholder="Username" required>
                </div>

                <!-- PASSWORD -->
                <div class="input-group">
                    <i class="fas fa-lock"></i>
                    <input type="password" name="password" id="loginPassword" placeholder="Password" required>
                    <i class="fas fa-eye toggle-password" data-target="loginPassword"></i>
                </div>

                <!-- LOGIN BUTTON -->
                <button type="submit" class="auth-btn">
                    <span>Login</span>
                    <i class="fas fa-arrow-right"></i>
                </button>

            </form>

            <!-- 🔥 DIVIDER -->
            <div style="text-align:center; margin:20px 0; color:#999;">
                OR
            </div>

            <!-- 🔥 GOOGLE LOGIN BUTTON -->
            <a href="/auth/google" style="text-decoration:none;">
                <button style="
                    width:100%;
                    padding:12px;
                    border:none;
                    border-radius:8px;
                    background:white;
                    border:1px solid #ddd;
                    display:flex;
                    align-items:center;
                    justify-content:center;
                    gap:10px;
                    cursor:pointer;
                    font-weight:500;
                ">
                    <img src="https://developers.google.com/identity/images/g-logo.png" width="20">
                    Continue with Google
                </button>
            </a>

        </div>
    </div>

    <script src="/js/script2.js"></script>

</body>

</html>